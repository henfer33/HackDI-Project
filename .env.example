# Supabase project settings -> API. The publishable/anon key only.
# Never put the service_role / sb_secret_ key in here; it bypasses row-level security.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxx

# Optional. Sends email through the apify/send-mail actor straight from the
# app. Compiled into the bundle, so use it for demos only; real sending
# belongs in the Edge Function, where the key stays on the server.
EXPO_PUBLIC_APIFY_TOKEN=apify_api_xxx
